// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Timeline image overlay planning > composites in track order before captions and the encoder filter without mixing image audio 1`] = `
{
  "args": [
    "-i",
    "one.mp4",
    "-i",
    "logo.png",
    "-/filter_complex",
    "filter.txt",
    "-map",
    "[video]",
    "-c:v",
    "libx264",
    "-preset",
    "ultrafast",
    "-crf",
    "23",
    "-map",
    "[audio]",
    "-c:a",
    "aac",
    "-ar",
    "48000",
    "-ac",
    "2",
    "-t",
    "2.000",
    "-movflags",
    "+faststart",
  ],
  "graph": "[0:v:0]null[i0v0];
[0:a:0]anull[i0a0];
[1:v:0]split=2[i1v0][i1v1];
[i0v0]trim=start=0.000:end=2.000,setpts=PTS-STARTPTS,scale=320:240:force_original_aspect_ratio=decrease:force_divisible_by=2,pad=320:240:(ow-iw)/2:(oh-ih)/2:color=black,fps=30,setsar=1,format=yuv420p,tpad=stop_mode=clone:stop_duration=0.050,trim=duration=2.000,settb=AVTB[v0];
[i0a0]atrim=start=0.000:end=2.000,asetpts=PTS-STARTPTS,aresample=48000,aformat=sample_fmts=fltp:channel_layouts=stereo,volume=1,adelay=0:all=1[a0];
[v0]concat=n=1:v=1:a=0,tpad=stop_mode=clone:stop_duration=2.000,trim=duration=2.000[base];
[i1v0]loop=loop=-1:size=1:start=0,fps=30,settb=AVTB,trim=duration=1.000,setpts=round((N+15)/(30*TB))-0.500/TB,scale=160:80,format=yuva420p,colorchannelmixer=aa=0.5,tpad=stop_mode=clone:stop=1,fade=t=in:st=0:d=0.200:alpha=1,fade=t=out:st=0.700:d=0.300:alpha=1,setpts=PTS+0.500/TB[ov0];
[base][ov0]overlay=x=0:y=80:eof_action=pass:enable='between(t,0.500,1.500)*lt(t,1.500)'[over0];
[i1v1]loop=loop=-1:size=1:start=0,fps=30,settb=AVTB,trim=duration=2.000,setpts=round((N+0)/(30*TB))-0.000/TB,scale=80:40,format=yuva420p,colorchannelmixer=aa=1,tpad=stop_mode=clone:stop=1,setpts=PTS+0.000/TB[ov1];
[over0][ov1]overlay=x=200:y=100:eof_action=pass:enable='between(t,0.000,2.000)*lt(t,2.000)'[over1];
[over1]format=yuv420p,ass=captions.ass:fontsdir=fonts,format=nv12[video];
anullsrc=r=48000:cl=stereo,atrim=duration=2.000[silence];
[silence][a0]amix=inputs=2:normalize=0,alimiter=level=0:latency=1,apad,atrim=duration=2.000[audio]
",
}
`;

exports[`Timeline render planning > snapshots a crossfade and the clips own audio crossfade 1`] = `
{
  "args": [
    "-i",
    "one.mp4",
    "-/filter_complex",
