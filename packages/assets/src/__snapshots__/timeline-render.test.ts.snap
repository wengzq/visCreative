    "-crf",
    "23",
    "-map",
    "[audio]",
    "-c:a",
    "aac",
    "-ar",
    "48000",
    "-ac",
    "2",
    "-t",
    "3.500",
    "-movflags",
    "+faststart",
  ],
  "copies": [],
  "cwd": "<sources>",
  "durationMs": 3500,
  "ext": "mp4",
  "files": [
    {
      "content": "[0:v:0]split=2[i0v0][i0v1];
[0:a:0]asplit=2[i0a0][i0a1];
[i0v0]trim=start=0.000:end=2.000,setpts=PTS-STARTPTS,scale=320:240:force_original_aspect_ratio=decrease:force_divisible_by=2,pad=320:240:(ow-iw)/2:(oh-ih)/2:color=black,fps=30,setsar=1,format=yuv420p,tpad=stop_mode=clone:stop_duration=0.050,trim=duration=2.000,settb=AVTB[v0];
[i0a0]atrim=start=0.000:end=2.000,asetpts=PTS-STARTPTS,aresample=48000,aformat=sample_fmts=fltp:channel_layouts=stereo,volume=1,afade=t=out:st=1.500:d=0.500,adelay=0:all=1[a0];
[i0v1]trim=start=0.000:end=2.000,setpts=PTS-STARTPTS,scale=320:240:force_original_aspect_ratio=decrease:force_divisible_by=2,pad=320:240:(ow-iw)/2:(oh-ih)/2:color=black,fps=30,setsar=1,format=yuv420p,tpad=stop_mode=clone:stop_duration=0.050,trim=duration=2.000,settb=AVTB[v1];
[i0a1]atrim=start=0.000:end=2.000,asetpts=PTS-STARTPTS,aresample=48000,aformat=sample_fmts=fltp:channel_layouts=stereo,volume=1,afade=t=in:st=0:d=0.500,adelay=1500:all=1[a1];
[v0][v1]xfade=transition=fade:duration=0.500:offset=1.500,fps=30,settb=AVTB[fold1];
[fold1]tpad=stop_mode=clone:stop_duration=3.500,trim=duration=3.500[video];
anullsrc=r=48000:cl=stereo,atrim=duration=3.500[silence];
[silence][a0][a1]amix=inputs=3:normalize=0,alimiter=level=0:latency=1,apad,atrim=duration=3.500[audio]
",
      "name": "filter.txt",
    },
  ],
  "fps": 30,
  "height": 240,
  "mode": "encode",
  "output": "video",
  "width": 320,
}
`;

