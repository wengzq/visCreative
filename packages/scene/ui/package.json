{
  "name": "@vis/scene-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Scene editor, connected through an injected host. Load it with a dynamic import so three.js stays out of the main bundle.",
  "exports": {
    ".": "./src/index.ts",
    "./scene.css": "./src/scene.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@vis/protocol": "workspace:*",
    "@vis/scene-core": "workspace:*",
    "@vis/ui-kit": "workspace:*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "~0.187.0"
  }
}
